{
  "name": "gnome-fuzzy-clock-gb",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "check:js": "node --check extension.js && node --check fuzzyTime.js && node --check eslint.config.js && node --check tests/*.mjs",
    "check:shell": "bash -n scripts/*.sh",
    "check:package": "./scripts/package.sh && python3 scripts/check-package.py dist/fuzzy-clock-gb@nedrichards.shell-extension.zip",
    "test:unit": "node --test",
    "test": "npm run lint && npm run check:js && npm run check:shell && npm run test:unit"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-gnome": "git+https://gitlab.gnome.org/World/javascript/eslint-config-gnome.git#c479d059e8d9ea99c3b53c2ea43abf7fdb05eb51",
    "globals": "^17.13.0"
  }
}
